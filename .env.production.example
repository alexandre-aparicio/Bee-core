# Bee-Core production environment. Copy to .env and replace all values.
# API stays private inside Docker in production; this is the host port for the web UI.
BEE_CORE_PORT=3000
BEE_WEB_PORT=3011
PUBLIC_BASE_DOMAIN=beecore.beeprojects.net
MONGODB_DB=bee_core
JWT_SECRET=REPLACE_WITH_64_PLUS_RANDOM_HEX_CHARACTERS
AUTH_ADMIN_EMAIL=admin@example.com
AUTH_ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_PASSWORD_12_OR_MORE_CHARACTERS
# Generate with: openssl rand -base64 32; keep this key backed up securely.
AUTH_MFA_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=REPLACE_WITH_HEX_64_CHARACTERS
MONGO_APP_USERNAME=bee_core_app
MONGO_APP_PASSWORD=REPLACE_WITH_HEX_64_CHARACTERS

# Mail account credential encryption (generate a dedicated secret, never reuse JWT/MFA keys).
BEE_MAIL_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
BEE_MAIL_SYNC_INTERVAL_SECONDS=300
