# Bee-Core production environment. Copy to .env and replace all values.
# API stays private inside Docker in production; this is the host port for the web UI.
BEE_CORE_PORT=3000
BEE_WEB_PORT=3011
PUBLIC_BASE_DOMAIN=beecore.beeprojects.net
MONGODB_DB=bee_core
JWT_SECRET=REPLACE_WITH_64_PLUS_RANDOM_HEX_CHARACTERS
AUTH_ADMIN_EMAIL=admin@example.com
AUTH_ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_PASSWORD_12_OR_MORE_CHARACTERS
