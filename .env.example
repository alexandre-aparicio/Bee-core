# Development environment. Replace every placeholder before starting Compose.
BEE_CORE_PORT=3000
BEE_WEB_PORT=8080
MONGODB_DB=bee_core
JWT_SECRET=REPLACE_WITH_64_PLUS_RANDOM_HEX_CHARACTERS
AUTH_ADMIN_EMAIL=admin@example.com
AUTH_ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_PASSWORD_12_OR_MORE_CHARACTERS
# Generate with: openssl rand -base64 32
AUTH_MFA_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
# Generate both passwords with: openssl rand -hex 32
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=REPLACE_WITH_HEX_64_CHARACTERS
MONGO_APP_USERNAME=bee_core_app
MONGO_APP_PASSWORD=REPLACE_WITH_HEX_64_CHARACTERS

# Tenant mail integration: AES-256-GCM key used to encrypt stored mailbox credentials. Generate a unique 32+ character secret.
BEE_MAIL_ENCRYPTION_KEY=
# Poll mail accounts for new messages (minimum 60 seconds; default 300).
BEE_MAIL_SYNC_INTERVAL_SECONDS=300

# Dedicated key for encrypted tenant mail credentials.
BEE_MAIL_ENCRYPTION_KEY=
# Poll interval in seconds; the service clamps it to a minimum of 60 seconds.
BEE_MAIL_SYNC_INTERVAL_SECONDS=300
