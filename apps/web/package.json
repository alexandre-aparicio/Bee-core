    "@angular/platform-browser": "22.2.7",
    "@angular/router": "22.2.7",
    "@ng-icons/core": "31.4.0",
    "@ng-icons/lucide": "31.4.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@angular/animations": "22.2.7",
    "@angular/build": "22.2.7",
    "@angular/cli": "22.2.7",
