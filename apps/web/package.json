    "@angular/router": "19.2.15",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.15.1",
    "@ng-icons/core": "31.4.0",
    "@ng-icons/lucide": "31.4.0",
    "@angular/cdk": "19.2.15"
  },
  "devDependencies": {
    "@angular/build": "19.2.15",
    "@angular/cli": "19.2.15",
    "@angular/compiler-cli": "19.2.15",
    "@playwright/test": "1.65.1",
    "typescript": "5.8.3",
    "@angular-architects/native-federation": "19.0.23",
    "es-module-shims": "2.8.4",
