{
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "bee-core-web": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "bee",
      "architect": {
        "build": {
          "builder": "@angular-architects/native-federation:build",
          "options": {
            "projectName": "bee-core-web",
            "tsConfig": "tsconfig.federation.json",
            "esmsInitOptions": {
              "nonce": "__BEE_CSP_NONCE__"
            }
          },
          "configurations": {
            "production": {
              "target": "bee-core-web:esbuild:production"
            },
            "development": {
              "target": "bee-core-web:esbuild:development",
              "dev": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-architects/native-federation:build",
          "options": {
            "target": "bee-core-web:serve-original:development",
            "rebuildDelay": 500,
            "dev": true,
            "cacheExternalArtifacts": false,
            "port": 4200
          },
          "configurations": {
            "development": {
              "target": "bee-core-web:serve-original:development",
              "dev": true
            },
            "production": {
              "target": "bee-core-web:serve-original:production"
            }
          },
          "defaultConfiguration": "development"
        },
        "esbuild": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": [
              "zone.js",
              "es-module-shims"
            ],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "preview.svg",
                "input": "src/app/templates/packages/aurora/assets",
                "output": "assets/templates/aurora"
              },
              {
                "glob": "preview.svg",
                "input": "src/app/templates/packages/editorial/assets",
                "output": "assets/templates/editorial"
              },
              {
                "glob": "preview.svg",
                "input": "src/app/templates/packages/glass/assets",
                "output": "assets/templates/glass"
              },
              {
                "glob": "preview.svg",
                "input": "src/app/templates/packages/midnight/assets",
                "output": "assets/templates/midnight"
              },
              {
                "glob": "preview.svg",
                "input": "src/app/templates/packages/paper/assets",
                "output": "assets/templates/paper"
              },
              {
                "glob": "preview.svg",
                "input": "src/app/templates/packages/studio/assets",
                "output": "assets/templates/studio"
              },
              {
                "glob": "**/*",
                "input": "src/assets/device-simulator",
                "output": "assets/device-simulator"
              }
            ],
            "scripts": [
              "src/assets/qrcode.min.js"
            ],
            "styles": [
              "src/app/templates/base/tokens.contract.css",
              "src/app/templates/base/base.css",
              "src/app/templates/packages/midnight/tokens.css",
              "src/app/templates/packages/paper/tokens.css",
              "src/app/templates/packages/glass/tokens.css",
              "src/app/templates/packages/aurora/tokens.css",
              "src/app/templates/packages/editorial/tokens.css",
              "src/app/templates/packages/studio/tokens.css",
              "src/styles.css"
            ],
            "outputMode": "static"
          },
          "configurations": {
            "development": {
              "optimization": false,
              "sourceMap": true
            },
            "production": {
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": true
              },
              "outputHashing": "all"
            }
          },
          "defaultConfiguration": "production"
        },
        "serve-original": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "bee-core-web:esbuild:production"
            },
            "development": {
              "buildTarget": "bee-core-web:esbuild:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    },
    "connected-devices-remote": {
      "projectType": "application",
      "root": "../../plugins/connected-devices/frontend",
      "sourceRoot": "../../plugins/connected-devices/frontend/src",
      "prefix": "bee",
      "architect": {
        "esbuild": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/connected-devices-remote",
            "index": "../../plugins/connected-devices/frontend/src/index.html",
            "browser": "../../plugins/connected-devices/frontend/src/main.ts",
            "polyfills": [
              "zone.js",
              "es-module-shims"
            ],
            "tsConfig": "../../plugins/connected-devices/frontend/tsconfig.app.json",
            "assets": [
              {
                "glob": "qrcode.min.js",
                "input": "../../plugins/connected-devices/frontend/src/assets",
                "output": "assets"
              }
            ],
            "styles": []
          },
          "configurations": {
            "production": {
              "optimization": true,
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "build": {
          "builder": "@angular-architects/native-federation:build",
          "options": {
            "projectName": "connected-devices-remote",
            "tsConfig": "../../plugins/connected-devices/frontend/tsconfig.federation.json"
          },
          "configurations": {
            "production": {
              "target": "connected-devices-remote:esbuild:production"
            },
            "development": {
              "target": "connected-devices-remote:esbuild:development",
              "dev": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve-original": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "connected-devices-remote:esbuild:production"
            },
            "development": {
              "buildTarget": "connected-devices-remote:esbuild:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "serve": {
          "builder": "@angular-architects/native-federation:build",
          "options": {
            "target": "connected-devices-remote:serve-original:development",
            "rebuildDelay": 500,
            "dev": true,
            "cacheExternalArtifacts": false,
            "port": 4201
          },
          "defaultConfiguration": "development"
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
