{
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "bee-core-web": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "bee",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "preview.svg",
                "input": "src/app/templates/packages/aurora/assets",
                "output": "assets/templates/aurora"
              },
              {
                "glob": "preview.svg",
                "input": "src/app/templates/packages/editorial/assets",
                "output": "assets/templates/editorial"
              },
              {
                "glob": "preview.svg",
                "input": "src/app/templates/packages/glass/assets",
                "output": "assets/templates/glass"
              },
              {
                "glob": "preview.svg",
                "input": "src/app/templates/packages/midnight/assets",
                "output": "assets/templates/midnight"
              },
              {
                "glob": "preview.svg",
                "input": "src/app/templates/packages/paper/assets",
                "output": "assets/templates/paper"
              },
              {
                "glob": "preview.svg",
                "input": "src/app/templates/packages/studio/assets",
                "output": "assets/templates/studio"
              },
              {
                "glob": "**/*",
                "input": "src/assets/device-simulator",
                "output": "assets/device-simulator"
              }
            ],
            "scripts": [
              "src/assets/qrcode.min.js"
            ],
            "styles": [
              "src/styles.css"
            ],
            "outputMode": "static"
          },
          "configurations": {
            "production": {
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": true
              },
              "outputHashing": "all"
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "bee-core-web:build:production"
            },
            "development": {
              "buildTarget": "bee-core-web:build"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  },
  "cli": {
    "analytics": false
  },
  "schematics": {
    "@schematics/angular:component": {
      "type": "component"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  }
}
