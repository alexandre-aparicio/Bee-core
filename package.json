{
  "name": "@bee/core",
  "version": "0.3.1",
  "private": true,
  "description": "All-is-a-Plugin modular runtime",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test --test-concurrency=1 --test-timeout=120000 --test-force-exit test/*.test.ts",
    "build:plugin-packages": "npm run build && node scripts/build-connected-devices-remote.mjs && node scripts/build-time-tracking-remote.mjs && node scripts/build-plugin-packages.mjs"
  },
  "dependencies": {
    "@fastify/jwt": "^10.2.8",
    "@fastify/websocket": "^11.3.4",
    "bcryptjs": "^2.4.3",
    "fastify": "^5.2.1",
    "mongodb": "^7.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
